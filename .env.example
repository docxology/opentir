# Copy to .env and set a GitHub token if using online discovery.
GITHUB_TOKEN=
GITHUB_ORG=palantir
LOG_LEVEL=INFO
REQUESTS_PER_HOUR=5000
MAX_CONCURRENT_REQUESTS=10
REPOS_DIR=repos
DOCS_DIR=docs
CACHE_DIR=.cache
LOGS_DIR=logs
DOCS_THEME=material
ANALYSIS_DEPTH=comprehensive
INCLUDE_TESTS=true
INCLUDE_EXAMPLES=true
